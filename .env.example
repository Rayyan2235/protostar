# Copy to .env and fill in. .env is gitignored. Never commit keys.

# Which gateway serves the models: foundry | anthropic | nebulaone
# offline = no model calls; a fixed interview script so the UI and data gate can be tried without keys (labeled in the UI, not for the demo).
LLM_PROVIDER=foundry

# Key for the chosen provider.
LLM_API_KEY=

# foundry:   your Azure AI Foundry resource name (https://<resource>.services.ai.azure.com/anthropic/)
#            or set LLM_BASE_URL to the full endpoint instead.
# nebulaone: your gateway, e.g. https://<gateway>/anthropic (Anthropic-compatible, x-api-key header)
# anthropic: leave both empty.
LLM_FOUNDRY_RESOURCE=
LLM_BASE_URL=

# Model or deployment names. On Foundry these are your deployment names.
MODEL_CHEAP=claude-haiku-4-5
MODEL_CAPABLE=claude-sonnet-5
# Defaults to MODEL_CAPABLE when empty.
MODEL_JUDGE=

# SQLite file (gitignored). On Azure App Service use /home/data/protostar.db
DATABASE_PATH=./data/protostar.db
