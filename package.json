{
  "name": "protostar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "smoke": "tsx --env-file-if-exists=.env scripts/smoke.ts",
